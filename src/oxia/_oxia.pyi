"""Type stubs for the native module. See `oxia.client` for the public API."""

from typing import Iterator

# (version_id, modifications_count, created_timestamp_ms, modified_timestamp_ms,
#  session_id, client_identity)
_Version = tuple[int, int, int, int, int | None, str | None]
_Record = tuple[str, bytes | None, _Version]
# (notification_type, key, version_id, key_range_end)
_Notification = tuple[int, str, int, str | None]

class RangeScanIterator(Iterator[_Record]):
    def __iter__(self) -> RangeScanIterator: ...
    def __next__(self) -> _Record: ...
    def close(self) -> None: ...

class NotificationIterator(Iterator[_Notification]):
    def __iter__(self) -> NotificationIterator: ...
    def __next__(self) -> _Notification: ...
    def close(self) -> None: ...

class SequenceUpdatesIterator(Iterator[str]):
    def __iter__(self) -> SequenceUpdatesIterator: ...
    def __next__(self) -> str: ...
    def close(self) -> None: ...

class Client:
    def __init__(self, service_address: str, namespace: str, session_timeout_ms: int,
                 client_identifier: str | None = None) -> None: ...
    def put(self, key: str, value: bytes, partition_key: str | None = None,
            expected_version_id: int | None = None, ephemeral: bool = False,
            sequence_keys_deltas: list[int] | None = None,
            secondary_indexes: list[tuple[str, str]] | None = None) -> tuple[str, _Version]: ...
    def get(self, key: str, partition_key: str | None = None, comparison_type: int = 0,
            include_value: bool = True, use_index: str | None = None) -> _Record: ...
    def delete(self, key: str, partition_key: str | None = None,
               expected_version_id: int | None = None) -> bool: ...
    def delete_range(self, min_key_inclusive: str, max_key_exclusive: str,
                     partition_key: str | None = None) -> None: ...
    def list(self, min_key_inclusive: str, max_key_exclusive: str,
             partition_key: str | None = None, use_index: str | None = None) -> list[str]: ...
    def range_scan(self, min_key_inclusive: str, max_key_exclusive: str,
                   partition_key: str | None = None,
                   use_index: str | None = None) -> RangeScanIterator: ...
    def notifications(self) -> NotificationIterator: ...
    def sequence_updates(self, prefix_key: str, partition_key: str) -> SequenceUpdatesIterator: ...
    def close(self) -> None: ...
